# .env.local 로 복사해서 사용합니다. .env.local 은 git에 올라가지 않습니다.

# API 서버 주소. 개발 중 프록시(API_PROXY_TARGET)를 쓸 때는 비워 둡니다(/api 상대 경로로 호출).
VITE_API_BASE_URL=

# 개발 중 실제 서버 프록시(vite.config.ts). 서버가 CORS를 허용하지 않아 개발 서버가 대신 요청합니다.
# VITE_ 접두어가 없어 브라우저 번들에 들어가지 않습니다.
API_PROXY_TARGET=

# MSW 목. 개발: off면 목 전체를 끄고 모든 요청을 실제 서버로 보냅니다(기본 켜짐).
# 빌드(Vercel 배포): on일 때만 켜집니다. Vercel 환경 변수에 VITE_MOCK=on을 넣으세요.
# 일부 엔드포인트만 실제 서버로 보내려면 src/mocks/config.ts 의 passthrough에 추가하세요.
VITE_MOCK=on

# 개발용 로그인 토큰(src/app/dev-auth.ts). 배포에서 쓰려면 Vercel 환경 변수에 넣습니다(공개 번들에 포함됨). 백엔드에서 받은 값을 넣습니다.
# refresh가 있으면 access가 만료돼도 자동으로 재발급합니다.
VITE_DEV_ACCESS_TOKEN=
VITE_DEV_REFRESH_TOKEN=
